{
  "mcpServers": {
    "cteam": {
      "command": "./bin/win-x64/cteam.exe",
      "args": ["context-activation-server"],
      "cwd": ".",
      "enabled": true,
      "default_tools_approval_mode": "approve",
      "tools": {
        "cteam": { "approval_mode": "approve" }
      },
      "env_vars": ["CTEAM_EXPERIMENT_EVIDENCE", "CTEAM_CONTEXT_LABEL"],
      "startup_timeout_sec": 15,
      "tool_timeout_sec": 30
    }
  }
}
